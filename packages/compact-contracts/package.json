{
  "name": "@teapass/compact-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "compile": "../../scripts/compact-compile.sh contracts/private-amount.compact contracts/managed/private-amount",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/test/private-amount.test.ts src/test/inventory.test.ts",
    "test:local": "vitest run src/test/private-amount.devnet.test.ts",
    "compile:inventory": "../../scripts/compact-compile.sh contracts/inventory.compact contracts/managed/inventory",
    "compile:all": "npm run compile && npm run compile:inventory",
    "test:inventory:local": "vitest run src/test/inventory.devnet.test.ts",
    "verifier": "vite-node src/verifier-server.ts"
  },
  "dependencies": {
    "@midnight-ntwrk/compact-runtime": "0.16.0",
    "@midnight-ntwrk/midnight-js-contracts": "4.1.1",
    "@midnight-ntwrk/midnight-js-http-client-proof-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-indexer-public-data-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-level-private-state-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-network-id": "4.1.1",
    "@midnight-ntwrk/midnight-js-node-zk-config-provider": "4.1.1",
    "@midnight-ntwrk/midnight-js-protocol": "4.1.1",
    "@midnight-ntwrk/midnight-js-types": "4.1.1",
    "@midnight-ntwrk/midnight-js-utils": "4.1.1",
    "@midnight-ntwrk/testkit-js": "4.1.1",
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "axios": "^1.15.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "rxjs": "^7.8.2",
    "ws": "^8.14.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/ws": "^8.5.9",
    "typescript": "^5.7.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "@midnight-ntwrk/wallet-sdk": "1.2.0",
    "@midnight-ntwrk/onchain-runtime-v3": "3.0.0",
    "@midnight-ntwrk/compact-runtime": "0.16.0"
  }
}
