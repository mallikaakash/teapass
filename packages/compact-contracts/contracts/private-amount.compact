// TeaPass M0 compatibility probe. NOT an inventory issuance contract.
// No authorization, provenance, custody or food-safety claim is made here.
pragma language_version 0.23;
import CompactStandardLibrary;

export sealed ledger maximumGrams: Uint<64>;
export ledger commitments: Set<Bytes<32>>;
export ledger usedTags: Set<Bytes<32>>;

struct AmountRecord {
  domain: Bytes<32>;
  deployment: Bytes<32>;
  nonce: Bytes<32>;
  quantityGrams: Uint<64>;
}

constructor(maximum: Uint<64>) {
  assert(maximum > 0, "Maximum must be positive");
  maximumGrams = disclose(maximum);
}

export circuit recordAmount(quantityGrams: Uint<64>, nonce: Bytes<32>, salt: Bytes<32>): [] {
  assert(quantityGrams > 0, "Quantity must be positive");
  assert(quantityGrams <= maximumGrams, "Quantity exceeds maximum");
  const tag = disclose(persistentHash<Vector<3, Bytes<32>>>([
    pad(32, "TEAPASS_AMOUNT_TAG_V1"), kernel.self().bytes, nonce
  ]));
  assert(!usedTags.member(tag), "Nonce already used");
  const commitment = persistentCommit<AmountRecord>(AmountRecord {
    domain: pad(32, "TEAPASS_AMOUNT_PROBE_V1"),
    deployment: kernel.self().bytes,
    nonce: nonce,
    quantityGrams: quantityGrams
  }, salt);
  assert(!commitments.member(commitment), "Commitment already exists");
  usedTags.insert(tag);
  commitments.insert(commitment);
}
