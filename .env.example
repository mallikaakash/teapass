# Local host execution. Compose configures these separately for its private network.
TEAPASS_ENVIRONMENT=development
TEAPASS_DATABASE_URL=postgresql+psycopg://teapass:local-only@localhost:55432/teapass
TEAPASS_DEPLOYMENT_ID=teapass-local
TEAPASS_OIDC_ISSUER=http://localhost:8080/realms/teapass
TEAPASS_OIDC_AUDIENCE=teapass-api
TEAPASS_OIDC_JWKS_URL=http://localhost:8080/realms/teapass/protocol/openid-connect/certs
TEAPASS_CORS_ORIGINS=["http://localhost:3000"]

# Optional local Midnight integration after scripts/replay-judges.sh succeeds.
# TEAPASS_MIDNIGHT_CONTRACT_ADDRESS=<64-character address from inventory-local.json>
TEAPASS_MIDNIGHT_NETWORK=undeployed
TEAPASS_MIDNIGHT_INDEXER_URL=http://127.0.0.1:8088/api/v4/graphql
TEAPASS_MIDNIGHT_NODE_URL=http://127.0.0.1:9944
# TEAPASS_MIDNIGHT_VERIFIER_URL=http://127.0.0.1:6301
